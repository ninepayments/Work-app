rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function phoneDoc() { return get(/databases/$(database)/documents/phones/$(request.auth.token.phone_number)); } function member() { return request.auth != null && request.auth.token.phone_number != null && exists(/databases/$(database)/documents/phones/$(request.auth.token.phone_number)) && phoneDoc().data.active == true; } function isAdmin() { return member() && phoneDoc().data.admin == true; } function canPerf() { return member() && (phoneDoc().data.admin == true || phoneDoc().data.perf == true); } function canReport() { return member() && phoneDoc().data.get('report', false) == true; } function canMerchant() { return member() && (phoneDoc().data.admin == true || phoneDoc().data.get('medit', false) == true); } function myUid() { return phoneDoc().data.uid; } match /phones/{p} { allow read: if isAdmin() || (request.auth != null && request.auth.token.phone_number == p); allow create, update: if isAdmin(); allow delete: if false; } match /users/{id} { allow read: if member(); allow create, update: if isAdmin(); allow delete: if false; } match /tasks/{id} { allow read, create, update: if member(); allow delete: if false; } match /notices/{id} { allow read, create, update: if member(); allow delete: if false; } match /projects/{id} { allow read, create, update: if member(); allow delete: if false; } match /events/{id} { allow read, create, update: if member(); allow delete: if false; } match /merchants/{id} { allow read: if member(); allow create, update: if canMerchant() && request.resource.data.keys().hasOnly(['j', 'u']) && request.resource.data.j is string && request.resource.data.j.size() > 20 && request.resource.data.j.size() < 200000 && request.resource.data.u is int; allow delete: if false; } match /stock/{id} { allow read, create, update: if member(); allow delete: if false; } match /rooms/{id} { allow read, create, update: if member(); allow delete: if false; } match /msgs/{id} { allow read, create, update: if member(); allow delete: if false; } match /contacts/{id} { allow read, create, update: if member(); allow delete: if false; } match /deposits/{id} { allow read, create, update: if member(); allow delete: if false; } match /library/{id} { allow read, create, update: if member(); allow delete: if false; } match /mlogs/{id} { allow read, create, update: if member(); allow delete: if false; } match /prooms/{id} { allow read: if member() && request.auth.token.phone_number in resource.data.mem; allow create: if member() && request.auth.token.phone_number in request.resource.data.mem && request.resource.data.mem.size() >= 2 && request.resource.data.mem.size() <= 30; allow update: if member() && request.auth.token.phone_number in resource.data.mem && request.auth.token.phone_number in request.resource.data.mem && request.resource.data.mem.size() <= 30; allow delete: if false; } match /pmsgs/{id} { allow read: if member() && request.auth.token.phone_number in resource.data.mem; allow create: if member() && request.auth.token.phone_number in request.resource.data.mem && request.resource.data.mem.size() >= 2 && request.resource.data.mem.size() <= 30; allow update: if member() && request.auth.token.phone_number in resource.data.mem && request.resource.data.mem == resource.data.mem; allow delete: if false; } match /blobs/{id} { allow read, create: if member(); allow update, delete: if false; } match /profiles/{id} { allow read: if member(); allow create: if member() && request.resource.data.who == phoneDoc().data.uid; allow update: if member() && resource.data.who == phoneDoc().data.uid && request.resource.data.who == phoneDoc().data.uid; allow delete: if false; } match /costs/{id} { allow read, create, update: if canPerf(); allow delete: if false; } match /contracts/{id} { allow read: if canPerf() || (member() && resource.data.who == phoneDoc().data.uid); allow create: if member() && request.resource.data.who == phoneDoc().data.uid; allow update: if canPerf() || (member() && resource.data.who == phoneDoc().data.uid); allow delete: if false; } match /reports/{id} { allow read: if canReport() || (member() && resource.data.who == phoneDoc().data.uid); allow create: if member() && request.resource.data.who == phoneDoc().data.uid; allow update: if member() && resource.data.who == phoneDoc().data.uid; allow delete: if false; } match /config/{id} { allow read: if member(); allow create, update: if isAdmin(); allow delete: if false; } match /auditLogs/{id} { allow create: if member() && request.resource.data.who == myUid() && request.resource.data.keys().hasOnly(['who', 'a', 'c', 'id', 'name', 'n', 'u']) && request.resource.data.a in ['view', 'new', 'edit', 'delete', 'import', 'export', 'over'] && request.resource.data.u is int; allow read: if isAdmin(); allow update, delete: if false; } match /audit/{id} { allow create: if member(); allow read: if isAdmin(); allow update, delete: if false; } } }
