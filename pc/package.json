{
  "name": "nine-family-pc",
  "productName": "나인패밀리",
  "version": "0.0.5",
  "description": "나인패밀리 PC 프로그램 (웹앱을 PC 창으로 띄움)",
  "main": "main.js",
  "author": "(주)나인페이먼츠",
  "private": true,
  "scripts": {
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "kr.todanjeon.workapp.pc",
    "productName": "나인패밀리",
    "artifactName": "NineFamily-Setup.${ext}",
    "directories": {
      "buildResources": "res",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "widget.html",
      "widget-preload.js",
      "res/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "res/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "나인패밀리"
    }
  }
}
